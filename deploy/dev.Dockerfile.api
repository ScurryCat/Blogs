# PHANTOM LOG API —— 开发期镜像（T00）。
#
# 仅用于本地开发 Compose。生产镜像、非 root 加固、只读文件系统、健康探针细化
# 由 T10 负责；此文件不得被当作生产配置就绪的证据。
#
# 构建上下文是仓库根目录（见 compose.dev.yaml 的 context: ..）。

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    PATH="/opt/venv/bin:${PATH}"

# uv 只用于解析锁文件；不在镜像里保存任何密钥。
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

WORKDIR /srv/api

# 先复制依赖描述以利用层缓存；锁文件必须存在，--frozen 会拒绝隐式更新。
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --no-install-project

COPY apps/api/ ./
RUN uv sync --frozen

# 非 root 运行；媒体目录单独授权（06 §4）。
RUN useradd --system --uid 10001 --create-home phantom \
    && mkdir -p /var/lib/phantom-log/media \
    && chown -R phantom:phantom /srv/api /var/lib/phantom-log
USER phantom

EXPOSE 8000

# 首版单 worker（06 §1）。迁移不在这里执行。
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
