# PHANTOM LOG 受限试用环境变量示例（M1A）。
#
# 用法（完整流程见 docs/operations/trial-runbook.md）：
#   cp deploy/env/trial.env.example <部署机上的私有路径>/trial.env
#   chmod 600 <私有路径>/trial.env
#   # 生成试用访问口令哈希（明文不入编排）：
#   docker run -i --rm caddy:2.10.2-alpine caddy hash-password
#   # 填好下面所有 <必填> 后：
#   docker compose -f deploy/compose.prod.yaml -f deploy/compose.trial.yaml \
#     -p phantom-log-trial --env-file <私有路径>/trial.env config
#
# 安全边界：
#   - 本文件只提交**占位符**；实际 trial.env 含口令，必须留在部署机私有目录并 chmod 600。
#   - 数据库口令文件是宿主机文件（绝对路径），内容不要写进本 env 文件，除非是
#     migrate / api 拼接 DATABASE_URL 所需的两个 *_PASSWORD 变量（见下方取舍说明）。
#   - 试用项目必须用独立 `-p` 项目名与独立数据卷；不要与生产项目共用卷或端口。

# --- 项目与站点 ---
# 项目名用 `-p phantom-log-trial` 或 COMPOSE_PROJECT_NAME 注入；不要写进 compose 文件。
# 本机隔离验证固定 HTTP；真实试用由站主确认子域名后改成域名（Caddy 自动 HTTPS）。
SITE_ADDRESS=http://127.0.0.1:18091
GATEWAY_HTTP_HOST_PORT=18091
GATEWAY_HTTPS_HOST_PORT=18491

# --- 镜像 ---
# 本机隔离验证用本地构建 tag；真实试用按 CI 构建的不可变 digest 固定。
API_IMAGE=phantom-log-api:trial
WEB_IMAGE=phantom-log-web:trial
POSTGRES_IMAGE=postgres:18-alpine
CADDY_IMAGE=caddy:2.10.2-alpine
APP_VERSION=trial-local

# --- 网关独立访问认证（Basic Auth）---
# TRIAL_AUTH_HASH 是 bcrypt 哈希，含 `$` 字符：
#   - 写进本 env 文件时，每个 `$` 要写成 `$$`（Compose --env-file 会做 $VAR 插值；
#     tools/setup-trial-secrets.sh 自动处理，手工填写时必须注意）；
#   - 或在启动命令前用 shell 环境变量注入（环境变量优先于 env 文件，按字面值使用）。
TRIAL_AUTH_USER=<必填：试用访问用户名>
TRIAL_AUTH_HASH=<必填：caddy hash-password 输出的 bcrypt 哈希；env 文件里每个 $ 写成 $$>

# --- 数据库 ---
POSTGRES_DB=pl
POSTGRES_ADMIN_USER=pl_admin
POSTGRES_MIGRATOR_USER=pl_migrator
POSTGRES_APP_USER=pl_app
# 三个口令文件：绝对路径、chmod 600、每行一个口令。生产/试用的真实路径不要提交。
POSTGRES_ADMIN_PASSWORD_FILE=<必填：/绝对路径/postgres_admin_password>
POSTGRES_MIGRATOR_PASSWORD_FILE=<必填：/绝对路径/postgres_migrator_password>
POSTGRES_APP_PASSWORD_FILE=<必填：/绝对路径/postgres_app_password>
# 仅用于 migrate / api 拼 DATABASE_URL（既有取舍，见 docs/operations/backup-restore.md）；
# 值必须与对应文件内容一致。完全消除需要应用支持 DATABASE_URL_FILE（已有支持，二者择一）。
POSTGRES_MIGRATOR_PASSWORD=<必填：与 migrator 口令文件一致>
POSTGRES_APP_PASSWORD=<必填：与 app 口令文件一致>

# --- API ---
# 至少 32 字符，不能是占位符；每个环境单独生成：openssl rand -hex 32
SECRET_KEY=<必填：openssl rand -hex 32>
MEDIA_MAX_CONCURRENCY=2
