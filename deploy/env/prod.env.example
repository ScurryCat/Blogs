# PHANTOM LOG 生产环境变量示例（T10）。
#
# 用法：
#   cp deploy/env/prod.env.example deploy/env/prod.env
#   chmod 600 deploy/env/prod.env          # 只给运行编排的账号读
#   # 填真实值（下面标 <必填> 的都要换掉），然后：
#   docker compose -f deploy/compose.prod.yaml --env-file deploy/env/prod.env config
#
# 本文件里只有占位符，没有任何可直接使用的口令。
# `deploy/env/*.env` 已被 .gitignore 忽略；**不要把填好的 prod.env 提交**。
#
# 口令怎么生成：
#   openssl rand -base64 32      # 每个都要单独生成，不要复用
#
# 关于 secrets 的取舍（06 §2）：
#   - 数据库三个角色的口令都走**文件**（`*_PASSWORD_FILE`），值不出现在
#     `docker inspect` 的环境变量里。文件必须 chmod 600、只属于运行编排的账号。
#   - 仍有一处真实残留：`migrate` / `api` 的 `DATABASE_URL` 是插值字符串，口令会进这两个
#     容器的环境变量。消除它需要应用侧支持 `DATABASE_URL_FILE`（T01 所有的 core 代码），
#     属集成申请，T10 不擅自改业务代码。详见 docs/operations/backup-restore.md。
#   - Compose secrets 只做访问隔离，不等于磁盘加密；宿主机权限才是真正的边界。

# --- 镜像（06 §2：CI 构建、按提交 SHA 标记，生产只引用不可变 digest）---
# 生产**不要**用 `latest`，也不要在这里现场 build：同一次发布用同一份构建。
# 形如 registry.example.com/phantom-log/api@sha256:<64 位十六进制>
API_IMAGE=<必填：API 镜像引用@sha256 digest>
WEB_IMAGE=<必填：Web 镜像引用@sha256 digest>
# PostgreSQL 与 Caddy 也按 digest 固定；只写 tag 是「可解析但不保证不可变」。
POSTGRES_IMAGE=postgres:18-alpine
CADDY_IMAGE=caddy:2.10.2-alpine

# --- 本次发布的版本标记（进健康端点与发布记录）---
APP_VERSION=0.0.0

# --- 站点与域名 ---
# 有真实域名时写域名（Caddy 自动 HTTPS）；没有域名时只能 HTTP 冒烟
# （SITE_ADDRESS=http://127.0.0.1:8080 并只映射 GATEWAY_HTTP_HOST_PORT）。
SITE_ADDRESS=<必填：例如 blog.example.com>
# 宿主端口；本机冒烟用 8080，避免与旧站 8000 等常见占用冲突。
GATEWAY_HTTP_HOST_PORT=80
GATEWAY_HTTPS_HOST_PORT=443

# --- 数据库账号（06 §2：运行账号不是超级用户，迁移账号与运行账号分开）---
POSTGRES_DB=pl
POSTGRES_ADMIN_USER=pl_admin
POSTGRES_MIGRATOR_USER=pl_migrator
POSTGRES_APP_USER=pl_app

# --- 数据库口令文件（绝对路径，chmod 600，每行一个口令、不要引号）---
POSTGRES_ADMIN_PASSWORD_FILE=/etc/phantom-log/secrets/postgres_admin_password
POSTGRES_MIGRATOR_PASSWORD_FILE=/etc/phantom-log/secrets/postgres_migrator_password
POSTGRES_APP_PASSWORD_FILE=/etc/phantom-log/secrets/postgres_app_password

# --- 数据库口令（**只给 migrate / api 拼 DATABASE_URL 用**；见上面的取舍说明）---
POSTGRES_MIGRATOR_PASSWORD=<必填：与 POSTGRES_MIGRATOR_PASSWORD_FILE 内容一致>
POSTGRES_APP_PASSWORD=<必填：与 POSTGRES_APP_PASSWORD_FILE 内容一致>

# --- API ---
# 至少 32 字符，且不能是占位符（app/core/config.py 在 prod 下会拒绝启动）。
SECRET_KEY=<必填：openssl rand -hex 32>
# 首版 2（05 §8 的建议值），按服务器内存调整。
MEDIA_MAX_CONCURRENCY=2

# --- 备份（deploy/backup.py 读取；不是容器变量）---
# 备份目的地：必须能放到宿主机之外（06 §5）。
PL_BACKUP_DIR=/var/backups/phantom-log
# pg_dump / pg_restore / psql 的目录；不设则从 PATH 找。
# PG_BIN=/usr/lib/postgresql/18/bin
