# PHANTOM LOG 开发环境变量示例（T10 从 deploy/env.example 迁移过来，内容不变）。
#
# 用法：
#   cp deploy/env/dev.env.example deploy/env/dev.env
#   docker compose -f deploy/compose.dev.yaml --env-file deploy/env/dev.env config
#
# 这里只有占位符，没有任何可直接用于生产的口令。compose.dev.yaml 对密码与密钥
# 使用 ${VAR:?} 强制注入：缺失时 compose 直接拒绝启动，而不是回落到默认值。

# --- 数据库 ---
POSTGRES_USER=pl
# 必填。请自行生成，例如：openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=pl_dev

# --- API ---
# 必填，至少 32 字符。请自行生成，例如：openssl rand -hex 32
SECRET_KEY=replace-with-a-local-development-secret-at-least-32-chars
# 开发期分端口的显式来源；带凭据请求不允许配成 "*"。
CORS_ORIGINS=http://127.0.0.1:3100

# --- 媒体 ---
# 容器内路径，必须与 compose 里 media_data 的挂载点一致。
# 媒体只由 API 授权读取，不作为网关公开静态目录；原图仅管理用途。
MEDIA_ROOT=/var/lib/phantom-log/media
# 有界图片并发。
MEDIA_MAX_CONCURRENCY=2
