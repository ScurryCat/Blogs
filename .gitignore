# 忽略规则不会让已跟踪的资源自动退出版本管理。
# assets/music/*.mp3

# 系统垃圾
.DS_Store
Thumbs.db

# Python 字节码缓存（tools/ 里的生成脚本）
__pycache__/
*.pyc

# 部署版本标记（由 tools/deploy/version.py 生成，不入库）
version.json

# 临时设计讨论与预览，不作为站点资源发布
.superpowers/

# 本地环境变量文件：只提交 .env.example，绝不提交真实密钥
.env
.env.local
.env.*
!.env.example
!**/.env.example
deploy/.env
deploy/env/*.env
apps/api/.env
apps/web/.env

# 本地秘密和备份目录；示例配置仍入库
deploy/secrets/
deploy/backups/

# 前端构建产物与依赖（T00 引入 Next.js 后新增）
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Python 虚拟环境（uv 在 apps/api 下创建）
.venv/

# 本地媒体根（开发期由 MEDIA_ROOT 指向这里；T09 建议，T00 采纳）。
# 内容是本机上传的验证素材，不该进仓库。
apps/api/var/

# 本地工具状态与验证缓存，不依赖某台机器的 .git/info/exclude
.dsh/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage/
apps/web/playwright-report/
apps/web/test-results/

# 新交接 ZIP 默认作为本地产物；既有已跟踪快照保持不变
docs/handoff-package-*.zip
docs/handoff/*.zip
