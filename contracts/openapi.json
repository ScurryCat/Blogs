  "info": {
    "title": "PHANTOM LOG API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/media": {
      "post": {
        "description": "上传 → 校验 → 派生变体 → 文件落位 → 记录 ready。\n\n任何一步失败都不会返回 201：失败时客户端拿不到「上传成功」的假信号。",
        "operationId": "upload_media_api_v1_admin_media_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_media_api_v1_admin_media_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaAdminOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "上传单张图片（站主）",
        "tags": [
          "admin-media"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatusOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "站主登录",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/LogoutIn"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "注销",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "read_session_api_v1_auth_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatusOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "读取会话状态与 CSRF token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "description": "只报告进程自身的存活状态（06 §1：liveness 仅判断进程是否响应）。\n\n不查数据库、不查媒体卷、不查 schema。**本文件刻意不提供 `/health/ready`**：\nreadiness 要验证 DB 可用、schema 版本兼容与媒体目录可用，属 T01 / T10 的实现，\n用永远返回 ok 的占位实现冒充就绪被交接计划明确禁止。\n\n响应字段名文档未规定，此处只给最小状态，且不泄漏连接串、目录、数据库名或堆栈。",
        "operationId": "health_live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Live Api V1 Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "进程存活状态",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "health_ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Ready Api V1 Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "未就绪，响应体给出未通过的检查项"
          }
        },
        "summary": "服务就绪状态（DB / schema / 媒体目录）",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/media/{media_id}/{variant}": {
      "get": {
        "description": "站主可以读原图与已撤回对象；匿名只读有公开引用的 ready 变体。",
        "operationId": "read_media_api_v1_media__media_id___variant__get",
        "parameters": [
          {
            "in": "path",
            "name": "media_id",
            "required": true,
            "schema": {
              "title": "Media Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "variant",
            "required": true,
            "schema": {
              "title": "Variant",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "读取媒体变体",
        "tags": [
          "media"
        ]
      }
    },
    "/api/v1/posts": {
      "get": {
        "operationId": "list_posts_api_v1_posts_get",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tag"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 12,
              "maximum": 30,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostListOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "公开文章列表",
        "tags": [
          "posts"
        ]
      }
    },
    "/api/v1/posts/{slug}": {
      "get": {
        "operationId": "read_post_api_v1_posts__slug__get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostDetailOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "公开文章详情",
        "tags": [
          "posts"
        ]
      }
    },
    "/api/v1/tags": {
      "get": {
        "operationId": "list_tags_api_v1_tags_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TagPublicOut"
                  },
                  "title": "Response List Tags Api V1 Tags Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "公开标签列表",
        "tags": [
          "tags"
        ]
      }
    }
  }
}
